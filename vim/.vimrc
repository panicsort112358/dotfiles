" Display
set number
set signcolumn=yes
set scrolloff=4
set splitbelow
set splitright

" Search
set ignorecase
set smartcase
set incsearch
set hlsearch

" Indentation
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

" Language support
filetype plugin indent on
syntax enable

" Command-line completion
set wildmenu
set wildmode=longest:full,full
